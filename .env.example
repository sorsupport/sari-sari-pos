PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Postgres connection string. For Vercel Postgres, run `vercel env pull .env`
# after adding the database in your Vercel project dashboard to fill this in
# automatically. For local development, point this at any Postgres instance,
# e.g. postgres://user:password@localhost:5432/sari_sari_pos
POSTGRES_URL=

