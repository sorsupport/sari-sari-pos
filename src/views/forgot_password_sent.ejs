<%- include('partials/auth_start') %>
<%- include('partials/auth_back') %>
<div class="auth-success">
  <%- include('partials/auth_check') %>
  <h1 class="auth-title">Request sent</h1>
  <p class="auth-lead">We let your admin know that <strong>@<%= username %></strong> needs a new password.</p>
</div>

<ol class="auth-steps">
  <li><span>Your admin sets a temporary password for you.</span></li>
  <li><span>They'll give it to you in person or by message.</span></li>
  <li><span>Sign in and choose a new password.</span></li>
</ol>

<a href="/login" class="auth-btn">Back to sign in</a>
<%- include('partials/auth_end') %>
