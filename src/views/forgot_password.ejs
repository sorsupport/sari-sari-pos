<%- include('partials/auth_start') %>
<%- include('partials/auth_back') %>
<h1 class="auth-title">Forgot password?</h1>
<p class="auth-lead">Passwords are managed by your store admin. Send a reset request and they'll give you a temporary password.</p>

<form method="POST" action="/forgot-password" novalidate data-validate>
  <div class="auth-field<%= errors.username ? ' has-error' : '' %>">
    <label for="username">Username</label>
    <input class="auth-input" type="text" id="username" name="username" value="<%= values.username || '' %>"
           placeholder="Your username" autocomplete="username" autocapitalize="none" spellcheck="false"
           <%= values.username ? '' : 'autofocus' %> data-required="Enter your username."
           <% if (errors.username) { %>aria-invalid="true" aria-describedby="username-error"<% } %> />
    <%- include('partials/auth_field_error', { id: 'username', message: errors.username }) %>
  </div>
  <div class="auth-field">
    <label for="message">Message to admin <span class="auth-optional">(optional)</span></label>
    <textarea class="auth-input" id="message" name="message" rows="3" maxlength="500"
              placeholder="Anything that helps, like when you're on shift" <%= values.username ? 'autofocus' : '' %>><%= values.message || '' %></textarea>
  </div>

  <button type="submit" class="auth-btn">Send reset request</button>
</form>

<p class="auth-alt">Remembered it? <a href="/login">Sign in</a></p>
<%- include('partials/auth_end') %>
