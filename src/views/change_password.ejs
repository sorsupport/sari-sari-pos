<%- include('partials/auth_start') %>
<h1 class="auth-title">Set a new password</h1>
<p class="auth-lead">You signed in with a temporary password. Choose your own to continue.</p>

<form method="POST" action="/change-password" novalidate data-validate>
  <div class="auth-field<%= errors.password ? ' has-error' : '' %>">
    <label for="password">New password</label>
    <input class="auth-input" type="password" id="password" name="password" autocomplete="new-password" autofocus
           placeholder="At least 6 characters" data-required="Enter a new password."
           <% if (errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %> />
    <%- include('partials/auth_field_error', { id: 'password', message: errors.password }) %>
  </div>
  <div class="auth-field<%= errors.confirm_password ? ' has-error' : '' %>">
    <label for="confirm_password">Confirm new password</label>
    <input class="auth-input" type="password" id="confirm_password" name="confirm_password" autocomplete="new-password"
           data-required="Type the password again."
           <% if (errors.confirm_password) { %>aria-invalid="true" aria-describedby="confirm_password-error"<% } %> />
    <%- include('partials/auth_field_error', { id: 'confirm_password', message: errors.confirm_password }) %>
  </div>

  <button type="submit" class="auth-btn">Save password</button>
</form>

<form method="POST" action="/logout" class="auth-alt">
  Not you? <button type="submit" class="auth-link-button">Sign out</button>
</form>
<%- include('partials/auth_end') %>
