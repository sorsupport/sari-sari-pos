<header class="topbar">
  <div class="topbar-brand">
    <img src="/mang-inasal-logo.jpg" alt="Mang Inasal logo" />
    <span>Sari-Sari POS</span>
  </div>
  <nav class="topbar-nav">
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/products">Products</a>
      <a href="/admin/sales">Sales</a>
      <a href="/admin/inventory-reports">Inventory Reports</a>
      <a href="/admin/users">Users</a>
    <% } else if (currentUser && currentUser.role === 'sales_rep') { %>
      <a href="/pos">Point of Sale</a>
      <a href="/pos/inventory">Inventory</a>
    <% } %>
  </nav>
  <div class="topbar-user">
    <% if (currentUser) { %>
      <span><%= currentUser.fullName %> (<%= currentUser.role === 'admin' ? 'Admin' : 'Sales Rep' %>)</span>
      <form method="POST" action="/logout" class="inline-form">
        <button type="submit" class="link-button">Logout</button>
      </form>
    <% } %>
  </div>
</header>
<% if (flash && flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if (flash && flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>
