<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container pos-layout">
  <div class="pos-products">
    <h1>Point of Sale</h1>
    <input type="search" id="productSearch" placeholder="Search product or scan barcode..." autofocus />
    <div class="product-grid" id="productGrid">
      <% products.forEach(p => { %>
        <button
          type="button"
          class="product-tile"
          data-id="<%= p.id %>"
          data-name="<%= p.name %>"
          data-price="<%= p.selling_price %>"
          data-stock="<%= p.stock_quantity %>"
          data-unit="<%= p.unit %>"
        >
          <span class="product-name"><%= p.name %></span>
          <span class="product-price"><%= peso(p.selling_price) %></span>
          <span class="product-stock"><%= p.stock_quantity %> <%= p.unit %> left</span>
        </button>
      <% }) %>
    </div>
  </div>

  <div class="pos-cart">
    <h2>Cart</h2>
    <table class="table" id="cartTable">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
      <tbody id="cartBody"></tbody>
    </table>
    <div class="cart-total">Total: <span id="cartTotal">₱0.00</span></div>

    <form method="POST" action="/pos/checkout" id="checkoutForm">
      <input type="hidden" name="items" id="itemsInput" />
      <fieldset class="pay-methods">
        <legend>Payment</legend>
        <label><input type="radio" name="payment_method" value="cash" checked /><span>Cash</span></label>
        <label><input type="radio" name="payment_method" value="gcash" /><span>GCash</span></label>
        <label><input type="radio" name="payment_method" value="card" /><span>Card</span></label>
      </fieldset>
      <label id="amountPaidField">Amount Paid
        <input type="number" step="0.01" min="0" name="amount_paid" id="amountPaid" required />
      </label>
      <label id="paymentRefField" hidden>Reference No.
        <input type="text" name="payment_ref" id="paymentRef" maxlength="60" autocomplete="off" placeholder="From the GCash or card slip" />
      </label>
      <div class="cart-change" id="changeRow">Change: <span id="changeAmount">₱0.00</span></div>
      <button type="submit" class="btn btn-primary btn-block" id="checkoutBtn" disabled>Complete Sale</button>
    </form>
  </div>
</main>
<script src="/js/pos.js"></script>
<%- include('../partials/foot') %>
