<%- include('partials/auth_start') %>
<h1 class="auth-title">Sign in</h1>
<p class="auth-lead">Use the account your store admin created for you.</p>

<% if (error) { %><div class="auth-alert" role="alert"><%= error %></div><% } %>
<% if (flash && flash.success) { %><div class="auth-alert auth-alert-success" role="status"><%= flash.success %></div><% } %>

<form method="POST" action="/login" novalidate data-validate>
  <div class="auth-field">
    <label for="username">Username</label>
    <input class="auth-input" type="text" id="username" name="username" value="<%= values.username || '' %>"
           autocomplete="username" autocapitalize="none" spellcheck="false" autofocus
           data-required="Enter your username." />
  </div>
  <div class="auth-field">
    <label for="password">Password</label>
    <input class="auth-input" type="password" id="password" name="password" autocomplete="current-password"
           data-required="Enter your password." />
  </div>

  <div class="auth-row">
    <label class="auth-checkbox">
      <input type="checkbox" name="remember" <%= values.remember ? 'checked' : '' %> />
      <span>Keep me signed in</span>
    </label>
    <a href="/forgot-password" class="auth-link" id="forgotLink">Forgot password?</a>
  </div>

  <button type="submit" class="auth-btn">Sign in</button>
</form>

<p class="auth-alt">No account yet? <a href="/request-access">Request access</a></p>

<script>
  // Carry the typed username over to the forgot-password form.
  document.getElementById('forgotLink').addEventListener('click', function (e) {
    var username = document.getElementById('username').value.trim();
    if (username) {
      e.preventDefault();
      window.location.href = '/forgot-password?username=' + encodeURIComponent(username);
    }
  });
</script>
<%- include('partials/auth_end') %>
